{
  "name": "patient-care-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "患者医疗信息核验与就医导航 Agent — 前端与后端统一启动入口",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node scripts/dev.js --backend-only",
    "dev:frontend": "node scripts/dev.js --frontend-only",
    "docker:infra": "docker compose up -d",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -m pytest -q",
    "test:frontend": "npm --prefix frontend test",
    "lint": "npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build"
  }
}
